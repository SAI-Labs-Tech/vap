{
  "$id": "https://saiwallet.ai/vap/0.1/attestation.json",
  "title": "VAP Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "profile",
    "bindingHash",
    "role",
    "keyId",
    "verdict",
    "viewHash",
    "evidenceRoot",
    "verifierVersion",
    "reasonCodes",
    "issuedAt",
    "expiresAt",
    "signature"
  ],
  "properties": {
    "protocolVersion": { "const": "0.1" },
    "profile": { "const": "offchain-ed25519-v1" },
    "bindingHash": { "type": "string", "minLength": 64, "maxLength": 64 },
    "role": {
      "type": "string",
      "enum": [
        "intent-authority",
        "proposer",
        "semantic-verifier",
        "safety-verifier",
        "execution-gate",
        "execution-adapter",
        "receipt-verifier",
        "redaction-service"
      ]
    },
    "keyId": { "type": "string" },
    "verdict": {
      "type": "string",
      "enum": ["PREPARED", "PASS", "DENY", "INCONCLUSIVE", "NEEDS_INPUT"]
    },
    "viewHash": { "type": "string" },
    "evidenceRoot": { "type": "string" },
    "verifierVersion": { "type": "string" },
    "reasonCodes": { "type": "array", "items": { "type": "string" } },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "signature": { "type": "string" }
  }
}
