{
  "name": "@sai-labs/guard-mcp",
  "version": "0.1.0",
  "description": "SAI Guard MCP server. Verifies transaction proposals for MCP-compatible agents; does not sign or broadcast.",
  "license": "MIT",
  "homepage": "https://guard.sai-labs.pro",
  "bugs": {
    "url": "https://github.com/SAI-Labs-Tech/vap/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SAI-Labs-Tech/vap.git",
    "directory": "packages/guard-mcp"
  },
  "author": "SAI Labs",
  "keywords": [
    "sai",
    "sai-labs",
    "sai-guard",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "transaction-security",
    "blockchain",
    "wallet"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "guard-mcp": "./dist/cli.js",
    "sai-guard-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@sai-labs/guard": "0.1.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
