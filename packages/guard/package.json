{
  "name": "@sai-labs/guard",
  "version": "0.1.0",
  "description": "SAI Guard Protocol TypeScript SDK. Pre-signing transaction verification client.",
  "license": "MIT",
  "homepage": "https://guard.sai-labs.pro",
  "bugs": {
    "url": "https://github.com/SAI-Labs-Tech/vap/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SAI-Labs-Tech/vap.git",
    "directory": "packages/guard"
  },
  "author": "SAI Labs",
  "keywords": [
    "sai",
    "sai-labs",
    "sai-guard",
    "blockchain",
    "wallet",
    "transaction-security",
    "transaction-simulation",
    "web3",
    "crypto",
    "security"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "SAI_GUARD_INTEGRATION_TESTS=1 vitest run --config vitest.integration.config.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
